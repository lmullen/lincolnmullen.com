.DS_Store
node_modules
public
.hugo_build.lock
# Commit Hugo's processed-image cache so Cloudflare builds reuse it instead of
# re-encoding every image (issue #176). Run ./gen-cache.sh to add missing
# variants and prune stale ones; see "Processed-image cache" in .claude/CLAUDE.md.
resources/*
!resources/_gen/
resources/_gen/*
!resources/_gen/images/

# Claude Code local settings
.claude/settings.local.json

# Git worktrees
.worktrees/

# Rendered newsletter issues (generated for pasting into Kit)
digests/*.html
!digests/kit-template.html
