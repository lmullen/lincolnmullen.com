# Pages that moved, or that never had a page of their own
/blog/tag/* /archive/ 302
/blog/categories/* /archive/ 302
/courses/uws/* /teaching/ 301
/projects/helsinki-workshop/* /blog/materials-for-dh-workshop-at-the-university-of-helsinki/ 301

# A link elsewhere on the web that repeats the domain as a path
/https%3A/lincolnmullen.com/* /:splat 301

# Computational Historical Thinking (dh-r) is offline: dh-r.lincolnmullen.com
# no longer resolves. Send its old URLs to the source repository until it is
# back, with 302s so they can be repointed.
/projects/dh-r/* https://github.com/lmullen/dh-r 302
/projects/dh-r2/* https://github.com/lmullen/dh-r 302
/projects/worksheets/* https://github.com/lmullen/dh-r 302
