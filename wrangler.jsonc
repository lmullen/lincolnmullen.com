{
	"name": "lincolnmullen-dot-com",
	"compatibility_date": "2025-01-29",
	"build": {
		// Cloudflare's build image has an older Hugo, so cloudflare-build.sh fetches
		// the one pinned in .mise.toml, from the URL in mise.lock, and checks it
		// against the checksum there before building.
		"command": "./cloudflare-build.sh"
	},
	"assets": {
		"directory": "./public",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page",
		"run_worker_first": false
	},
	"workers_dev": true,
	"preview_urls": true
}
