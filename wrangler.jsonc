{
	"name": "lincolnmullen-dot-com",
	"compatibility_date": "2025-01-29",
	"build": {
		// Pin Hugo to the version in .mise.toml (gen-cache.sh checks that the two
		// agree). Cloudflare's build image otherwise defaults to an older Hugo
		// (0.147.7) that lacks newer template methods. Fetch the exact binary and
		// call ./hugo, not the preinstalled one.
		"command": "curl -sSL https://github.com/gohugoio/hugo/releases/download/v0.169.0/hugo_extended_0.169.0_linux-amd64.tar.gz | tar -xzf - hugo && ./hugo --cleanDestinationDir --minify --baseURL \"https://lincolnmullen.com\""
	},
	"assets": {
		"directory": "./public",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page",
		"run_worker_first": false
	},
	"workers_dev": true,
	"preview_urls": true
}
